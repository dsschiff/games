extends "res://tests/input_base.gd"
const Challenge = preload("res://scripts/challenge_v1.gd")
const Flow = preload("res://tests/challenge_flow.gd")
func _initialize() -> void:
	root.size = Vector2i(600, 1066)
	rendered = DisplayServer.get_name() != "headless"
	folder = "res://.artifacts/challenge-v1/motion"
	test_path = "user://challenge-v1-movie.json"
	call_deferred("run")

func beat_room(id: String) -> void:
	await choose(id)
	await wait_frames(15)
	await action("enter")
	await wait_frames(62)

func run() -> void:
	DirAccess.make_dir_recursive_absolute(folder)
	for suffix in ["", ".tmp", ".bak", ".bak.tmp"]: DirAccess.remove_absolute(test_path + suffix)
	await create_game()
	await action("settings")
	await action("challenge_select")
	await Flow.type_seed(self, 137)
	await wait_frames(45)
	await frame("00-seeded-setup")
	await action("generate")
	var first: Dictionary = game.data.challenge_run.bundle.duplicate(true)
	await frame("01-key-start")
	for id in first.bad_route: await beat_room(id)
	check(game.state.status == "lost", "Movie shows natural losing key commitment")
	await frame("02-key-loss")
	await wait_frames(35)
	await action("undo")
	await action("retry")
	for id in first.witness: await beat_room(id)
	check(game.state.status == "won", "Movie shows corrected key victory")
	await frame("03-key-victory")
	await wait_frames(35)
	await action("next")
	check(game.data.challenge_run.bundle == first, "Movie Replay keeps exact snapshot")
	await beat_room(first.witness[0])
	await action("challenge_new")
	check(game.data.challenge_run.bundle.seed == 138, "Movie New advances visible seed")
	await action("settings")
	await action("challenge_select")
	await action("family_shell")
	await wait_frames(30)
	await action("generate")
	var second: Dictionary = game.data.challenge_run.bundle.duplicate(true)
	await frame("04-shell-start")
	for id in second.witness: await beat_room(id)
	check(game.state.status == "won", "Movie shows shell/trap/lens victory")
	await frame("05-shell-victory")
	await wait_frames(45)
	await action("settings")
	await action("challenge_select")
	await action("records")
	await frame("06-record-book")
	await wait_frames(65)
	var file := FileAccess.open(folder + "/result.json", FileAccess.WRITE)
	file.store_string(JSON.stringify({"checks": checks, "failures": failures, "actual_touch_taps": taps, "keys": keys, "snapshots": [first, second], "scope": "Fresh game; actual seed/family/options UI, natural wrong commitment/Undo/Retry/win/Replay/New and second family; fixed60fps/Dummy audio, not phone FPS"}, "\t"))
	file.close()
	print("CHALLENGE MOTION: %d checks; %d failures" % [checks, failures.size()])
	game.queue_free()
	await wait_frames(3)
	if failures.is_empty(): print("SUITE_COMPLETE: PASS")
	quit(0 if failures.is_empty() else 1)
