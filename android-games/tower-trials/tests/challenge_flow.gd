extends RefCounted
const Challenge = preload("res://scripts/challenge_v1.gd")
const Rules = preload("res://scripts/rules.gd")
const Saves = preload("res://scripts/save_store.gd")

static func type_seed(driver: SceneTree, value: int) -> void:
	await driver.tap(Vector2(120, 474))
	await driver.press(KEY_A, true)
	await driver.press(KEY_BACKSPACE)
	for character in str(value): await driver.press(KEY_NONE, false, character.unicode_at(0))

static func run(driver: SceneTree) -> Dictionary:
	var campaign := {"level_id": driver.game.data.level_id, "catalog": driver.game.data.catalog, "actions": driver.game.data.actions.duplicate(), "profile": driver.game.data.profile.duplicate(true), "settings": driver.game.data.settings.duplicate(true), "used_undo": driver.game.data.used_undo}
	var rows: Array = []
	for family_index in 4:
		var family: String = Challenge.FAMILIES[family_index]
		await driver.action("settings")
		await driver.action("challenge_select")
		driver.check(driver.game.seed_edit.visible, "Native seed entry is visible")
		await driver.action("family_" + family)
		await type_seed(driver, 137 + family_index)
		if family_index == 2: await driver.action("treasure_option")
		if family_index == 3: await driver.action("weave")
		await driver.frame("challenge-%s-setup" % family)
		await driver.action("generate")
		driver.check(driver.game.data.kind == "challenge" and driver.game.data.challenge_run.bundle.family == family, "Actual setup generates " + family)
		var bundle: Dictionary = driver.game.data.challenge_run.bundle.duplicate(true)
		var initial := Rules.initial(bundle.snapshot)
		for key in driver.game.buttons(): driver.check(driver.game.buttons()[key].size.x >= 80 and driver.game.buttons()[key].size.y >= 80, "Challenge minimum hit target " + key)
		if family_index == 0:
			await driver.enter(bundle.witness[0])
			var active: Dictionary = driver.game.state.duplicate(true)
			await driver.frame("challenge-active-pinned")
			var fixture := FileAccess.open(driver.folder + "/active-pinned-save.json", FileAccess.WRITE)
			fixture.store_buffer(FileAccess.get_file_as_bytes(driver.test_path))
			fixture.close()
			driver.game.queue_free()
			await driver.wait_frames(3)
			await driver.create_game()
			driver.check(driver.game.state == active and driver.game.data.challenge_run.bundle == bundle, "Cold generated run keeps exact pinned snapshot and state")
			await driver.action("settings")
			await driver.action("transfer")
			driver.check(Saves.decode(driver.game.editor.text).ok, "Export includes valid generated snapshot and campaign")
			await driver.action("import")
			driver.check(driver.game.state == active and driver.game.data.challenge_run.bundle == bundle, "Actual import preserves generated snapshot")
			await driver.action("undo")
			driver.check(driver.game.state == initial, "Generated Undo restores all snapshot resources and routes")
		for id in bundle.bad_route: await driver.enter(id)
		driver.check(driver.game.state.status == "lost", "Natural generated losing commitment " + family)
		await driver.frame("challenge-%s-natural-loss" % family)
		if family_index == 0:
			var lost: Dictionary = driver.game.state.duplicate(true)
			driver.game.queue_free()
			await driver.wait_frames(3)
			await driver.create_game()
			driver.check(driver.game.state == lost and not driver.game.note.is_empty(), "Cold-restored generated defeat retains visible causal explanation")
			await driver.frame("challenge-cold-loss-reason")
		await driver.action("undo")
		driver.check(driver.game.state.status == "active", "Generated defeat Undo returns to preceding state")
		await driver.action("retry")
		driver.check(driver.game.state == initial and driver.game.data.challenge_run.bundle == bundle, "Retry pins same seed/snapshot rather than regenerating")
		for id in bundle.witness: await driver.enter(id)
		driver.check(driver.game.state.status == "won", "Natural generated victory " + family)
		await driver.frame("challenge-%s-natural-win" % family)
		var key: String = Challenge.validate(bundle).key
		driver.check(driver.game.data.challenge_records.any(func(record): return record.key == key), "Separate generated medal record earned " + family)
		if family_index == 0:
			await driver.action("next")
			driver.check(driver.game.state == initial and driver.game.data.challenge_run.bundle == bundle, "Replay retains exact generated definition")
			for id in bundle.medal_witness: await driver.enter(id)
			driver.check(driver.game.state.treasure > 0 and driver.game.data.challenge_records.any(func(record): return record.key == key and int(record.medals) & 4 != 0), "Actual treasure replay earns verified optional medal")
			await driver.action("settings")
			await driver.action("challenge_select")
			await driver.action("records")
			await driver.frame("challenge-records")
			await driver.action("record_0")
			driver.check(driver.game.data.challenge_run.bundle == bundle and driver.game.state == initial, "Record browser replays the same version/seed/options and verified definition")
		rows.append({"family": family, "seed": bundle.seed, "options": bundle.options, "snapshot_key": key, "win": bundle.witness, "loss": bundle.bad_route})
		await driver.action("challenge_new")
		driver.check(driver.game.data.challenge_run.bundle.seed == int(bundle.seed) + 1, "New generates next visible seed")
		await driver.action("map")
		driver.check(driver.game.data.kind == "campaign" and driver.game.data.actions == campaign.actions and driver.game.data.profile == campaign.profile and driver.game.data.settings == campaign.settings and driver.game.data.used_undo == campaign.used_undo and driver.game.data.level_id == campaign.level_id and driver.game.data.catalog == campaign.catalog, "Challenge leaves whole campaign route/profile/settings intact")
		await driver.action("resume")
	return {"families": rows, "campaign_preserved": true}
