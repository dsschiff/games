config_version=5

[application]
config/name="Tower Trials"
config/version="0.3.1"
config/quit_on_go_back=false
config/icon="res://icon.svg"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=600
window/size/viewport_height=1066
window/size/window_width_override=480
window/size/window_height_override=853
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035,0.065,0.12,1)

[audio]
driver/enable_input=false
