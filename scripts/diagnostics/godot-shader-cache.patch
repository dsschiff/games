+	if (format_count > 0 && format_count <= 256) {
+		Vector<GLint> supported;
+		supported.resize(format_count);
+		glGetIntegerv(GL_PROGRAM_BINARY_FORMATS, supported.ptrw());
+		for (int i = 0; i < format_count; i++) {
+			formats.push_back(int64_t(supported[i]));
+		}
+	}
+	p_record["supported_format_count"] = format_count;
+	p_record["supported_formats"] = formats;
+	p_record["format_query_bounded"] = format_count >= 0 && format_count <= 256;
+	p_record["errors_diagnostic_queries"] = _games_cache_errors();
+	_games_cache_print(p_record);
+}
