+// Opt-in observation: reads consume GL error flags; no cache or link decision changes.
+static Array _games_cache_errors() {
+	Array errors;
+	for (int i = 0; i < 16; i++) {
+		GLenum error = glGetError();
+		if (error == GL_NO_ERROR) {
+			return errors;
+		}
+		errors.push_back(int64_t(error));
+	}
+	errors.push_back("error_query_limit_reached");
+	return errors;
+}
+
+static String _games_cache_hash(const uint8_t *p_bytes, int p_size) {
+	unsigned char hash[32] = {};
+	Error result = CryptoCore::sha256(p_bytes, p_size, hash);
+	return result == OK ? String::hex_encode_buffer(hash, 32) : "hash_failed";
+}
+
+static Dictionary _games_cache_record(const String &p_name, const String &p_path, const String &p_base, const String &p_version, int p_variant, uint64_t p_specialization, GLenum p_format, const uint8_t *p_bytes, int p_size) {
+	Dictionary record;
+	record["schema"] = 1;
+	record["shader"] = p_name;
+	record["path"] = p_path;
+	record["base_sha256"] = p_base;
+	record["version_sha1"] = p_version;
+	record["variant"] = p_variant;
+	record["specialization_hex"] = String::num_uint64(p_specialization, 16);
+	record["binary_format"] = int64_t(p_format);
+	record["binary_bytes"] = p_size;
+	record["binary_sha256"] = _games_cache_hash(p_bytes, p_size);
+	return record;
+}
+
+static void _games_cache_print(const Dictionary &p_record) {
+	static std::atomic<uint64_t> next_record_id{ 0 };
+	const uint64_t record_id = next_record_id.fetch_add(1, std::memory_order_relaxed);
+	const CharString payload = JSON::stringify(p_record).utf8();
+	const int payload_size = payload.length();
+	const String payload_hash = _games_cache_hash((const uint8_t *)payload.ptr(), payload_size);
+	const int chunk_bytes = 384;
+	const int chunk_count = MAX(1, (payload_size + chunk_bytes - 1) / chunk_bytes);
+	for (int i = 0; i < chunk_count; i++) {
+		const int offset = i * chunk_bytes;
+		const int size = MIN(chunk_bytes, payload_size - offset);
+		Dictionary frame;
+		frame["schema"] = 2;
+		frame["record_id"] = String::num_uint64(record_id);
+		frame["payload_bytes"] = payload_size;
+		frame["payload_sha256"] = payload_hash;
+		frame["chunk_index"] = i;
+		frame["chunk_count"] = chunk_count;
+		frame["encoding"] = "base64";
+		frame["chunk_base64"] = CryptoCore::b64_encode_str((const uint8_t *)payload.ptr() + offset, size);
+		// Fixed ASCII metadata and <=512 base64 bytes stay below the observed 1023-byte log bound.
+		const String message = "GAMES_SHADER_CACHE_DIAGNOSTIC " + JSON::stringify(frame);
+		ERR_FAIL_COND_MSG(message.utf8().length() > 960, "Shader diagnostic frame exceeds the observed Android log budget.");
+		print_line(message);
+	}
+}
